# Production image: nginx + PHP-FPM in a single container.
# Stage 1: install locked composer deps (no dev).
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev --no-interaction --prefer-dist --no-scripts \
    --ignore-platform-reqs

# Stage 2: runtime.
FROM php:8.4-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx curl libpq-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo pdo_pgsql bcmath zip opcache \
    && rm -rf /var/lib/apt/lists \
    && rm -f /etc/nginx/sites-enabled/default

COPY docker/prod/nginx.conf /etc/nginx/sites-enabled/app.conf
COPY docker/prod/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www
COPY . .
COPY --from=vendor /app/vendor ./vendor

RUN mkdir -p storage/framework/sessions storage/framework/views \
        storage/framework/cache storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x docker/prod/start.sh

EXPOSE 80

CMD ["sh", "/var/www/docker/prod/start.sh"]
