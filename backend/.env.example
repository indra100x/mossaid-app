APP_ENV=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://mossaid:mossaid@db:5432/mossaid
DATABASE_URL_SYNC=postgresql+psycopg2://mossaid:mossaid@db:5432/mossaid
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
# Phase 3 — secrets, never commit real values
# Firebase Admin: either a file path or raw JSON (one of the two)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Admin dashboard password login (bcrypt hash, never plaintext).
# Generate a new hash: python -c "from app.core.security import hash_password; print(hash_password('new-password'))"
# Empty ADMIN_PASSWORD_HASH disables POST /auth/admin-login entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$mt7MxJTundPl10NY9hJEE.gyykt1QuUbLrlBcFcX3o92PLP09R8Mq
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
# Chargily (sandbox defaults; prod deploy overrides with live keys)
CHARGILY_API_KEY=test_6f2d8e2a-1234-4a5b-9c9d-test_sandbox_key
CHARGILY_API_SECRET=test_sandbox_secret_do_not_use_in_prod
CHARGILY_API_URL=https://pay.chargily.net/api/v2
CHARGILY_WEBHOOK_SECRET=test_webhook_secret
CHARGILY_SANDBOX=true
